; $VER: Install-OpenTTD 15.3-amigaos3-rc1 (17.11.2026)
; The Amiga Installer script for OpenTTD, an AmiCradle game port.
; Made by amicradle scripts/ports/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the OpenTTD drawer where the archive was unpacked.

(set @app-name "OpenTTD")
(set #version "15.3-amigaos3-rc1")
(set #drawer "OpenTTD")
(set #program "openttd")
(set #space 58594)  ; KB

(onerror
    (message (cat "OpenTTD was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-OpenTTD again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "OpenTTD needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "OpenTTD needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "OpenTTD needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The OpenTTD drawer is not beside Install-OpenTTD. Unpack the whole archive, then run Install-OpenTTD from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The OpenTTD drawer has no openttd in it. Unpack the whole archive again."))

(welcome "This installs OpenTTD 15.3-amigaos3-rc1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the OpenTTD drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called OpenTTD in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": OpenTTD needs 60 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "OpenTTD needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-OpenTTD again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2.module")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "save") (noreq))
    (set #kept (if (= #kept "") "save" (cat #kept "|" "save"))))
(if (exists (tackon #dest "scenario") (noreq))
    (set #kept (if (= #kept "") "scenario" (cat #kept "|" "scenario"))))
(if (exists (tackon #dest "heightmap") (noreq))
    (set #kept (if (= #kept "") "heightmap" (cat #kept "|" "heightmap"))))
(if (exists (tackon #dest "screenshot") (noreq))
    (set #kept (if (= #kept "") "screenshot" (cat #kept "|" "screenshot"))))
(if (exists (tackon #dest "content_download") (noreq))
    (set #kept (if (= #kept "") "content_download" (cat #kept "|" "content_download"))))
(if (exists (tackon #dest "openttd.cfg") (noreq))
    (set #kept (if (= #kept "") "openttd.cfg" (cat #kept "|" "openttd.cfg"))))
(if (exists (tackon #dest "private.cfg") (noreq))
    (set #kept (if (= #kept "") "private.cfg" (cat #kept "|" "private.cfg"))))
(if (exists (tackon #dest "secrets.cfg") (noreq))
    (set #kept (if (= #kept "") "secrets.cfg" (cat #kept "|" "secrets.cfg"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying OpenTTD")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating OpenTTD. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "OpenTTD.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "OpenTTD.info")))

(set #later "")

; the game data the drawer does not carry: downloaded with C:Atlas, or copied from
; the player's own drawer, disk or CD; each file's SHA-256 checked where the spec names it
(set #atlas (= (exists "C:Atlas" (noreq)) 1))

; your own Transport Tycoon Deluxe graphics, Windows edition
(set #into1 (tackon #dest "baseset"))
(if (<> (exists #into1 (noreq)) 2) (makedir #into1))
(set #have (and (= (exists (tackon #into1 "TRG1R.GRF") (noreq)) 1) (= (exists (tackon #into1 "TRGCR.GRF") (noreq)) 1) (= (exists (tackon #into1 "TRGHR.GRF") (noreq)) 1) (= (exists (tackon #into1 "TRGIR.GRF") (noreq)) 1) (= (exists (tackon #into1 "TRGTR.GRF") (noreq)) 1)))
(if (not #have)
    (
        (set #how
            (askchoice
                (prompt "OpenTTD needs your own Transport Tycoon Deluxe graphics, Windows edition. How should the Installer get it?")
                (help "OpenTTD needs your own Transport Tycoon Deluxe graphics, Windows edition: TRG1R.GRF, TRGCR.GRF, TRGHR.GRF, TRGIR.GRF, TRGTR.GRF, in baseset. Copy takes the files from a drawer you choose: the game's own install, a disk or a CD. The files come from https://wiki.openttd.org/en/Manual/Installation. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                (choices "Copy it from my own drawer, disk or CD" "Not now: the game starts without it")
                (default 0)))
        (if (= #how 0)
            (
                (set #src
                    (askdir
                        (prompt "Choose the drawer (or disk, or CD) that has TRG1R.GRF, TRGCR.GRF, TRGHR.GRF, TRGIR.GRF, TRGTR.GRF.")
                        (help "OpenTTD needs your own Transport Tycoon Deluxe graphics, Windows edition: TRG1R.GRF, TRGCR.GRF, TRGHR.GRF, TRGIR.GRF, TRGTR.GRF, in baseset. Copy takes the files from a drawer you choose: the game's own install, a disk or a CD. The files come from https://wiki.openttd.org/en/Manual/Installation. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                        (default #dest)))
                (set #ok 1)
                (if (<> (exists (tackon #src "TRG1R.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRG1R.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, Windows edition: run Install-OpenTTD again to choose another drawer."))))
                (if (<> (exists (tackon #src "TRGCR.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRGCR.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, Windows edition: run Install-OpenTTD again to choose another drawer."))))
                (if (<> (exists (tackon #src "TRGHR.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRGHR.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, Windows edition: run Install-OpenTTD again to choose another drawer."))))
                (if (<> (exists (tackon #src "TRGIR.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRGIR.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, Windows edition: run Install-OpenTTD again to choose another drawer."))))
                (if (<> (exists (tackon #src "TRGTR.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRGTR.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, Windows edition: run Install-OpenTTD again to choose another drawer."))))
                (if #ok
                    (copyfiles
                        (prompt "Copying your own Transport Tycoon Deluxe graphics, Windows edition")
                        (help @copyfiles-help)
                        (source #src)
                        (dest #into1)
                        (choices "TRG1R.GRF" "TRGCR.GRF" "TRGHR.GRF" "TRGIR.GRF" "TRGTR.GRF")
                        (optional "nofail" "force")))
            )
        )
        (if (= #how 1)
            (set #later (if (= #later "") "your own Transport Tycoon Deluxe graphics, Windows edition" (cat #later ", " "your own Transport Tycoon Deluxe graphics, Windows edition")))
        )
    )
)

; your own Transport Tycoon Deluxe graphics, DOS edition
(set #into2 (tackon #dest "baseset"))
(if (<> (exists #into2 (noreq)) 2) (makedir #into2))
(set #have (and (= (exists (tackon #into2 "TRG1.GRF") (noreq)) 1) (= (exists (tackon #into2 "TRGC.GRF") (noreq)) 1) (= (exists (tackon #into2 "TRGH.GRF") (noreq)) 1) (= (exists (tackon #into2 "TRGI.GRF") (noreq)) 1) (= (exists (tackon #into2 "TRGT.GRF") (noreq)) 1)))
(if (not #have)
    (
        (set #how
            (askchoice
                (prompt "OpenTTD needs your own Transport Tycoon Deluxe graphics, DOS edition. How should the Installer get it?")
                (help "OpenTTD needs your own Transport Tycoon Deluxe graphics, DOS edition: TRG1.GRF, TRGC.GRF, TRGH.GRF, TRGI.GRF, TRGT.GRF, in baseset. Copy takes the files from a drawer you choose: the game's own install, a disk or a CD. The files come from https://wiki.openttd.org/en/Manual/Installation. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                (choices "Copy it from my own drawer, disk or CD" "Not now: the game starts without it")
                (default 0)))
        (if (= #how 0)
            (
                (set #src
                    (askdir
                        (prompt "Choose the drawer (or disk, or CD) that has TRG1.GRF, TRGC.GRF, TRGH.GRF, TRGI.GRF, TRGT.GRF.")
                        (help "OpenTTD needs your own Transport Tycoon Deluxe graphics, DOS edition: TRG1.GRF, TRGC.GRF, TRGH.GRF, TRGI.GRF, TRGT.GRF, in baseset. Copy takes the files from a drawer you choose: the game's own install, a disk or a CD. The files come from https://wiki.openttd.org/en/Manual/Installation. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                        (default #dest)))
                (set #ok 1)
                (if (<> (exists (tackon #src "TRG1.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRG1.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, DOS edition: run Install-OpenTTD again to choose another drawer."))))
                (if (<> (exists (tackon #src "TRGC.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRGC.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, DOS edition: run Install-OpenTTD again to choose another drawer."))))
                (if (<> (exists (tackon #src "TRGH.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRGH.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, DOS edition: run Install-OpenTTD again to choose another drawer."))))
                (if (<> (exists (tackon #src "TRGI.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRGI.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, DOS edition: run Install-OpenTTD again to choose another drawer."))))
                (if (<> (exists (tackon #src "TRGT.GRF") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no TRGT.GRF in " #src ". Nothing was copied for your own Transport Tycoon Deluxe graphics, DOS edition: run Install-OpenTTD again to choose another drawer."))))
                (if #ok
                    (copyfiles
                        (prompt "Copying your own Transport Tycoon Deluxe graphics, DOS edition")
                        (help @copyfiles-help)
                        (source #src)
                        (dest #into2)
                        (choices "TRG1.GRF" "TRGC.GRF" "TRGH.GRF" "TRGI.GRF" "TRGT.GRF")
                        (optional "nofail" "force")))
            )
        )
        (if (= #how 1)
            (set #later (if (= #later "") "your own Transport Tycoon Deluxe graphics, DOS edition" (cat #later ", " "your own Transport Tycoon Deluxe graphics, DOS edition")))
        )
    )
)

; your own Transport Tycoon Deluxe sounds
(set #into3 (tackon #dest "baseset"))
(if (<> (exists #into3 (noreq)) 2) (makedir #into3))
(set #have (= (exists (tackon #into3 "SAMPLE.CAT") (noreq)) 1))
(if (not #have)
    (
        (set #how
            (askchoice
                (prompt "OpenTTD needs your own Transport Tycoon Deluxe sounds. How should the Installer get it?")
                (help "OpenTTD needs your own Transport Tycoon Deluxe sounds: SAMPLE.CAT, in baseset. Copy takes the files from a drawer you choose: the game's own install, a disk or a CD. The files come from https://wiki.openttd.org/en/Manual/Installation. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                (choices "Copy it from my own drawer, disk or CD" "Not now: the game starts without it")
                (default 0)))
        (if (= #how 0)
            (
                (set #src
                    (askdir
                        (prompt "Choose the drawer (or disk, or CD) that has SAMPLE.CAT.")
                        (help "OpenTTD needs your own Transport Tycoon Deluxe sounds: SAMPLE.CAT, in baseset. Copy takes the files from a drawer you choose: the game's own install, a disk or a CD. The files come from https://wiki.openttd.org/en/Manual/Installation. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                        (default #dest)))
                (set #ok 1)
                (if (<> (exists (tackon #src "SAMPLE.CAT") (noreq)) 1)
                    ((set #ok 0) (message (cat "There is no SAMPLE.CAT in " #src ". Nothing was copied for your own Transport Tycoon Deluxe sounds: run Install-OpenTTD again to choose another drawer."))))
                (if #ok
                    (copyfiles
                        (prompt "Copying your own Transport Tycoon Deluxe sounds")
                        (help @copyfiles-help)
                        (source #src)
                        (dest #into3)
                        (choices "SAMPLE.CAT")
                        (optional "nofail" "force")))
            )
        )
        (if (= #how 1)
            (set #later (if (= #later "") "your own Transport Tycoon Deluxe sounds" (cat #later ", " "your own Transport Tycoon Deluxe sounds")))
        )
    )
)
(complete 90)

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. OpenTTD would have gone in " #dest "."))
    (message (cat "OpenTTD 15.3-amigaos3-rc1 is installed in " #dest "."
                  "\n\nTo start it, open the OpenTTD drawer and double-click the openttd icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept "."))
                  (if (= #later "") "" (cat "\n\nStill to add to the drawer: " #later ". Run Install-OpenTTD again to fetch or copy it.")))))
(exit (quiet))
