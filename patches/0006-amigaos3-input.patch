 	if (!SDL_PollEvent(&ev)) return false;
 
+#if defined(__amigaos__)
+	/* AmigaOS: SetEnv OPENTTD_INPUT 1 and every key and mouse button SDL
+	 * gives the game goes into the log, with where the pointer is. */
+	static const bool log_input = [] {
+		extern std::string AmigaGetVar(const char *name);
+		return !AmigaGetVar("OPENTTD_INPUT").empty();
+	}();
+	if (log_input) {
+		switch (ev.type) {
+			case SDL_MOUSEBUTTONDOWN:
+			case SDL_MOUSEBUTTONUP:
+				Debug(driver, 0, "input: mouse button {} {} at {},{} (pointer {},{})", ev.button.button,
+					ev.type == SDL_MOUSEBUTTONDOWN ? "down" : "up", ev.button.x, ev.button.y, _cursor.pos.x, _cursor.pos.y);
+				break;
+			case SDL_MOUSEWHEEL:
+				Debug(driver, 0, "input: mouse wheel {},{}", ev.wheel.x, ev.wheel.y);
+				break;
+			case SDL_KEYDOWN:
+			case SDL_KEYUP:
+				Debug(driver, 0, "input: key {} {} (scancode {}, modifiers {:#x})", SDL_GetKeyName(ev.key.keysym.sym),
+					ev.type == SDL_KEYDOWN ? "down" : "up", static_cast<int>(ev.key.keysym.scancode), ev.key.keysym.mod);
+				break;
+			case SDL_TEXTINPUT:
+				Debug(driver, 0, "input: text \"{}\"", ev.text.text);
+				break;
+			case SDL_WINDOWEVENT:
+				Debug(driver, 0, "input: window event {}", ev.window.event);
+				break;
+			default: break;
+		}
+	}
+#endif
+
