diff --git a/src/fios.cpp b/src/fios.cpp
index 8b97c71..580667c 100644
--- a/src/fios.cpp
+++ b/src/fios.cpp
@@ -159,7 +159,12 @@ bool FiosBrowseTo(const FiosItem *item)
 				_fios_path->erase(s); // Remove last path separator character, so we can go up one level.
 			}
 
+#if defined(__amigaos__)
+			/* "PROGDIR:save" goes up to "PROGDIR:", the device or volume. */
+			s = _fios_path->find_last_of(PATHSEP ":");
+#else
 			s = _fios_path->find_last_of(PATHSEPCHAR);
+#endif
 			if (s != std::string::npos) {
 				_fios_path->erase(s + 1); // go up a directory
 			}
