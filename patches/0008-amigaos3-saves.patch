@@ -59,7 +59,12 @@
 
 bool FiosIsRoot(const std::string &path)
 {
+#if defined(__amigaos__)
+	/* AmigaOS: a device or volume ("PROGDIR:", "Work:") has nothing above it. */
+	return !path.empty() && path.back() == ':';
+#else
 	return path == PATHSEP;
+#endif
 }
 
