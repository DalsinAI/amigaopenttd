+#if defined(__amigaos__)
+/**
+ * AmigaOS: SetEnv OPENTTD_PERF to a number of seconds and every that many
+ * seconds the log gets the rates the frame rate window shows (game loop,
+ * drawing, video) and the sound mixer's average time, for measuring on a
+ * 68040 without the window on screen.
+ * @param now The time of the game loop just measured.
+ */
+static void AmigaPerformanceLog(TimingMeasurement now)
+{
+	static const TimingMeasurement interval = [] {
+		auto s = GetEnv("OPENTTD_PERF");
+		auto seconds = s.has_value() ? ParseInteger<uint32_t>(*s) : std::nullopt;
+		return static_cast<TimingMeasurement>(seconds.value_or(0)) * TIMESTAMP_PRECISION;
+	}();
+	static TimingMeasurement first = 0, next = 0;
+	if (interval == 0) return;
+	if (first == 0) first = next = now;
+	if (now < next) return;
+	next = now + interval;
+	Debug(misc, 0, "perf {:.1f} s: game loop {:.1f}/s (wants {:.1f}), drawing {:.1f}/s, video {:.1f}/s, sound mixing {:.2f} ms",
+		(double)(now - first) / TIMESTAMP_PRECISION,
+		_pf_data[PFE_GAMELOOP].GetRate(), _pf_data[PFE_GAMELOOP].expected_rate,
+		_pf_data[PFE_DRAWING].GetRate(), _pf_data[PFE_VIDEO].GetRate(),
+		_pf_data[PFE_SOUND].GetAverageDurationMilliseconds(NUM_FRAMERATE_POINTS));
+}
+#endif
+
